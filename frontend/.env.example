# Backend API base URL.
VITE_API_BASE=https://cip-api.dgisipl.com/api/v1
VITE_API_BASE_URL=https://cip-api.dgisipl.com/api/v1

# Web Push (VAPID) public key (base64url, no padding).
# OPTIONAL last-resort fallback: at subscribe time the app fetches the key
# from the backend (GET /notifications/push/vapid-public-key), which is the
# source of truth paired with the backend's VAPID_PRIVATE_KEY. Only set this
# if that endpoint may be unreachable, and it MUST be the same public key
# as the backend's VAPID_PUBLIC_KEY — a mismatch makes the push provider
# reject sends with 403 VAPID errors.
VITE_VAPID_PUBLIC_KEY=
